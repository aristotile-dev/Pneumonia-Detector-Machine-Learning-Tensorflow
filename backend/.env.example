# Set ONE of these (Groq is used first if both are set)
GROQ_API_KEY=
GEMINI_API_KEY=
# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# Optional: allow Vercel preview deploys
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# Model source (preferred): direct download URL, e.g. a Hugging Face resolve link
# MODEL_URL=https://huggingface.co/totz07/pneumonia-detector-densenet121/resolve/main/pneumonia_model_94.keras  (already the default)
# HF_TOKEN=   # only if that repo is private
